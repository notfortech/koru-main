table Dim_Product

	column ProductID
		dataType: string
		sourceColumn: ProductID
		summarizeBy: none
		isKey

	column ProductName
		dataType: string
		sourceColumn: ProductName
		summarizeBy: none

	column ProductCategory
		dataType: string
		sourceColumn: ProductCategory
		summarizeBy: none

	column ProductSubcategory
		dataType: string
		sourceColumn: ProductSubcategory
		summarizeBy: none

	partition Dim_Product = m
		mode: import
		source =
				let
					Source = Excel.Workbook(File.Contents(SourceFilePath), null, true),
					Data = Source{[Item="Products",Kind="Sheet"]}[Data],
					Promoted = Table.PromoteHeaders(Data, [PromoteAllScalars=true]),
					Typed = Table.TransformColumnTypes(Promoted,{
						{"ProductID", type text}, {"ProductName", type text},
						{"ProductCategory", type text}, {"ProductSubcategory", type text}
					})
				in
					Typed

	annotation PBI_ResultType = Table
