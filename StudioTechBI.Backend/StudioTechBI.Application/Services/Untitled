public class AIInsightsService
{
    private readonly IConfiguration _config;
    private readonly HttpClient _httpClient;

    public AIInsightsService(IConfiguration config, HttpClient httpClient)
    {
        _config = config;
        _httpClient = httpClient;
    }

    public async Task<string> GenerateInsights(string summaryData)
    {
        var apiKey = _config["OpenAI:ApiKey"];
        var model = _config["OpenAI:Model"];

        _httpClient.DefaultRequestHeaders.Authorization =
            new AuthenticationHeaderValue("Bearer", apiKey);

        var prompt = $@"
You are a senior financial analyst generating insights for a business dashboard.

Analyze the following data:

{summaryData}

Return response STRICTLY in this JSON format:

{{
  ""summary"": ""..."",
  ""keyInsights"": [""...""],
  ""risks"": [""...""],
  ""opportunities"": [""...""],
  ""recommendations"": [""...""]
}}
";

        var request = new
        {
            model = model,
            messages = new[]
            {
                new { role = "system", content = "You are precise, structured, and business-focused." },
                new { role = "user", content = prompt }
            },
            temperature = 0.2
        };

        var response = await _httpClient.PostAsync(
            "https://api.openai.com/v1/chat/completions",
            new StringContent(JsonSerializer.Serialize(request), Encoding.UTF8, "application/json")
        );

        if (!response.IsSuccessStatusCode)
        {
            var error = await response.Content.ReadAsStringAsync();
            throw new Exception($"OpenAI Error: {error}");
        }

        var json = await response.Content.ReadAsStringAsync();

        var result = JsonDocument.Parse(json);

        return result
            .RootElement
            .GetProperty("choices")[0]
            .GetProperty("message")
            .GetProperty("content")
            .GetString();
    }
}