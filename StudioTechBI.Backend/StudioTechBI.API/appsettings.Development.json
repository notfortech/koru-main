{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "MicrosoftAuth": {
    "RedirectUri": "http://localhost:5000/api/connections/oauth/onedrive/callback",
    "SuccessRedirectUri": "http://localhost:5173/client/insights"
  },
  "GoogleAuth": {
    "RedirectUri": "http://localhost:5000/api/connections/oauth/google/callback",
    "SuccessRedirectUri": "http://localhost:5173/client/insights"
  },
  "PasswordReset": {
    "TokenExpiryHours": 24,
    "ExposeTokenInResponse": true
  },
  "Startup": {
    "EnforceProductionConfigValidation": false
  },
  "UseDemoStorage": true,
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "https://localhost:5173"
    ]
  },
  "DomainApi": {
    "BaseUrl": "https://api.domain.com.au",
    "AuthBaseUrl": "https://auth.domain.com.au",
    "ClientId": "",
    "ClientSecret": "",
    "Scope": ""
  }
}
